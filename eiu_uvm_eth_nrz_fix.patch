diff --git a/verif/kernel/uvm_tb/sequence/bkp_smart_seq.sv b/verif/kernel/uvm_tb/sequence/bkp_smart_seq.sv
index a39b3b4..9a5fd4c 100644
--- a/verif/kernel/uvm_tb/sequence/bkp_smart_seq.sv
